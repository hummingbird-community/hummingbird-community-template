{{#ci}}
name: CI

on:
  push:
    branches:
    - main
    paths:
    - '**.swift'
    - '**.yml'
  pull_request:
  workflow_dispatch:

concurrency:
{{=<< >>=}}
  group: ${{ github.workflow }}-${{ github.ref }}-ci
<<={{ }}=>>
  cancel-in-progress: true

{{#count(env)}}
env:
{{#enumerated(env)}}
  {{{key}}}: "{{{value}}}"
{{/enumerated(env)}}

{{/count(env)}}
jobs:
{{#mac}}
  macOS:
    runs-on: macos-26
    timeout-minutes: 15
    steps:
    - name: Checkout
      uses: actions/checkout@v7
{{#enable_tests}}
    - name: SPM tests
      run: swift test --enable-code-coverage
    - name: Upload coverage data
      uses: vapor/swift-codecov-action@v0.3.7
      with:
{{=<< >>=}}
        codecov_token: ${{ secrets.CODECOV_TOKEN }}
<<={{ }}=>>
{{/enable_tests}}
{{^enable_tests}}
    - name: Build
      run: |
        swift build
{{/enable_tests}}
{{/mac}}
{{#linux}}
  linux:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    strategy:
      matrix:
        image: {{{images}}}
{{#services}}
    services:
      {{{.}}}
{{/services}}
    container:
      {{=<< >>=}}
      image: ${{ matrix.image }}
      <<={{ }}=>>
    steps:
    - name: Install curl
      run: apt-get update -yq && apt-get install -y curl
    - name: Checkout
      uses: actions/checkout@v7
{{#enable_tests}}
    - name: Test
      run: |
        swift test --enable-code-coverage
    - name: Upload coverage data
      uses: vapor/swift-codecov-action@v0.3.7
      with:
{{=<< >>=}}
        codecov_token: ${{ secrets.CODECOV_TOKEN }}
<<={{ }}=>>
{{/enable_tests}}
{{^enable_tests}}
    - name: Build
      run: |
        swift build
{{/enable_tests}}
{{/linux}}
{{/ci}}
